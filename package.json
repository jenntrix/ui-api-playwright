{
  "name": "ui-api-playwright",
  "version": "1.0.0",
  "description": "Playwright UI and API automation framework for OrangeHRM and Disney API",
  "main": "index.js",
  "scripts": {
  "test": "playwright test",
  "test:ui": "playwright test tests/specs/ui-orangehrm",
  "test:api": "playwright test tests/specs/api-disney",
  "test:debug": "playwright test --debug",
  "report:playwright": "playwright show-report",
  "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
  "docker:build": "docker build -t ui-api-playwright .",
  "docker:test": "docker run --rm --env-file .env ui-api-playwright"
  },
  "keywords": [],
  "author": "Jennifer Herrera",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.8.1"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
